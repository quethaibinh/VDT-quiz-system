# PostgreSQL used by auth-service
DB_AUTH_PORT=5433
DB_AUTH_NAME=auth-service-db
DB_AUTH_USERNAME=postgres
DB_AUTH_PASSWORD=change-me

# PostgreSQL used by question-service
DB_QUESTION_PORT=5434
DB_QUESTION_NAME=question-service-db
DB_QUESTION_USERNAME=postgres
DB_QUESTION_PASSWORD=change-me
DB_QUESTION_URL=jdbc:postgresql://localhost:5434/question-service-db

# PostgreSQL used by exam-service
DB_EXAM_PORT=5435
DB_EXAM_NAME=exam-service-db
DB_EXAM_USERNAME=postgres
DB_EXAM_PASSWORD=change-me
DB_EXAM_URL=jdbc:postgresql://localhost:5435/exam-service-db

# PostgreSQL used by examruntime-service
DB_EXAMRUNTIME_PORT=5436
DB_EXAMRUNTIME_NAME=examruntime-service-db
DB_EXAMRUNTIME_USERNAME=postgres
DB_EXAMRUNTIME_PASSWORD=change-me
DB_EXAMRUNTIME_URL=jdbc:postgresql://localhost:5436/examruntime-service-db

# Shared authentication secrets
# Replace these examples with sufficiently long random values.
JWT_SECRET=replace-with-a-base64-encoded-secret
GATEWAY_TRUSTED_SECRET=replace-with-a-long-random-gateway-secret
INTERNAL_API_KEY=replace-with-a-long-random-internal-api-key
AES_KEY=replace-with-a-valid-base64-encoded-aes-key
HMAC_KEY=replace-with-a-long-random-hmac-secret

# Internal service URLs used inside Docker network
QUESTION_SERVICE_URL=http://question-service:8082

# Teacher frontend
FRONTEND_PORT=3000

# MinIO used by question-service media upload
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET_QUESTION_MEDIA=quiz-question-media
QUESTION_MEDIA_MAX_BYTES=5242880
QUESTION_MEDIA_ALLOWED_TYPES=image/png,image/jpeg,image/webp

# Kafka used by exam-service activation outbox producer
KAFKA_HOST_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EXAM_KAFKA_TOPIC_EXAM_LIFECYCLE=exam-lifecycle-events
EXAMRUNTIME_KAFKA_GROUP_ID=examruntime-service
EXAMRUNTIME_KAFKA_TOPIC_LIVE_QUIZ_RESULT=live-quiz-result-events
EXAMRUNTIME_ANSWERS_CHECKPOINT_FIXED_DELAY_MS=10000
RESULT_SERVICE_KAFKA_GROUP_ID=result-service
RESULT_RUNTIME_SUBMISSIONS_TOPIC=runtime-submission-events
RESULT_LIVE_QUIZ_RESULTS_TOPIC=live-quiz-result-events
